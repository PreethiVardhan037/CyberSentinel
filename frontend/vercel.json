{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "VITE_API_URL": {
      "description": "URL of the deployed CyberSentinel FastAPI backend",
      "value": "https://cybersentinel-api.onrender.com"
    }
  }
}
