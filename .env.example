# CyberSentinel environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Backend API URL used by the frontend.
# Development default: http://localhost:8000 (set automatically via Vite proxy)
# Production: set this to your deployed backend URL, e.g.:
#   VITE_API_URL=https://cybersentinel-api.onrender.com
VITE_API_URL=http://localhost:8000

# Allowed CORS origins for the FastAPI backend (comma-separated).
# Development default: localhost (set in code)
# Production: set to your deployed frontend URL, e.g.:
#   CYBERSENTINEL_ALLOWED_ORIGINS=https://cybersentinel.vercel.app
CYBERSENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
